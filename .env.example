# Rhombus AI
RHOMBUS_BASE_URL=https://rhombusai.com
# Login email for the Rhombus test account
RHOMBUS_EMAIL=
# Login password for the Rhombus test account
RHOMBUS_PASSWORD=
# TODO: from the browser network tab
RHOMBUS_API_BASE_URL=
# TODO: from the browser network tab (for API tests)
RHOMBUS_AUTH_TOKEN=

# AWS (source)
# Region of the source bucket
AWS_REGION=ap-southeast-2
# Source bucket name
S3_BUCKET=rhombus-qa-source-shwan
# Key of the input CSV Rhombus reads
S3_INPUT_KEY=input/orders.csv
# Local AWS CLI profile used by the scripts
AWS_PROFILE=

# GCP (destination)
# Destination bucket name
GCS_BUCKET=rhombus-qa-dest-shwan
# TODO: output filename or prefix Rhombus writes to
GCS_OUTPUT_PREFIX=
# Path OUTSIDE this repo, or leave blank to use gcloud login
GOOGLE_APPLICATION_CREDENTIALS=
